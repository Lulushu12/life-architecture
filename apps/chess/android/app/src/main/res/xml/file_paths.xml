<?xml version="1.0" encoding="utf-8"?>
<!--
  Capacitor's template shared the whole of external storage and the cache dir
  through the FileProvider. Only the backup share needs a content:// URI, so
  only its own cache subfolder is exposed (see src/backupFile.js).
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="backups" path="backups/" />
</paths>
